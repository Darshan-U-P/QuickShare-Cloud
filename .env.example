# Local development template. Never commit your real .env file.
GITHUB_TOKEN=
GITHUB_OWNER=Darshan-U-P
GITHUB_REPO=QuickShare-Storage
GITHUB_BRANCH=main

# User sign-in (Google OpenID Connect).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Separate storage authorization for the administrator's private Google Drive.
# Add this callback URI to Google Auth Platform -> Clients -> Authorized redirect URIs.
GOOGLE_DRIVE_REDIRECT_URI=
STORAGE_ADMIN_EMAIL=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional only if you already have a folder created/authorized for this app.
GOOGLE_DRIVE_FOLDER_ID=

PUBLIC_BASE_URL=
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-random-flask-session-secret
# Generate separately and keep stable so Google account ownership remains stable across deployments.
OWNER_HASH_SECRET=replace-with-a-different-random-owner-hash-secret
MAX_CONTENT_LENGTH_MB=4
CRON_SECRET=

# Explicitly approved Google accounts may upload up to 50 GB per file.
# Comma-separate the exact verified email addresses; blank means nobody is approved.
LARGE_UPLOAD_ALLOWED_EMAILS=

# Optional VPS transfer service used to stream large Drive downloads outside Vercel.
# Set this after deploying transfer_service.py on your existing VPS.
TRANSFER_SERVICE_URL=https://transfer.qshare.darshanup.online
# Generate one random secret and use the same value in Vercel and the VPS environment.
TRANSFER_TOKEN_SECRET=
TRANSFER_TICKET_MAX_AGE_SECONDS=172800
