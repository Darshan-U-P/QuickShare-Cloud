# Copy this file to .env and fill in your own values.
# Never commit .env or paste the token into public source code.
GITHUB_TOKEN=
GITHUB_OWNER=Darshan-U-P
GITHUB_REPO=QuickShare-Storage
GITHUB_BRANCH=main

# Optional public base URL for links/QR codes. Leave blank for local browser testing.
# For phone access, configure the app for your LAN/public host deliberately first.
PUBLIC_BASE_URL=

# Local development only
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-random-local-secret
MAX_CONTENT_LENGTH_MB=5
