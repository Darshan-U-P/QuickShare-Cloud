# Local development template. Never commit your real .env file.
GITHUB_TOKEN=
GITHUB_OWNER=Darshan-U-P
GITHUB_REPO=QuickShare-Storage
GITHUB_BRANCH=main

# Google OpenID Connect settings. Set GOOGLE_REDIRECT_URI exactly to an authorized callback URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional canonical share URL base; normally leave blank on Vercel.
PUBLIC_BASE_URL=

FLASK_DEBUG=0
SECRET_KEY=replace-with-a-random-flask-session-secret
# Generate separately and keep stable so account ownership remains stable across deployments.
OWNER_HASH_SECRET=replace-with-a-different-random-owner-hash-secret
MAX_CONTENT_LENGTH_MB=3

# Required for the protected Vercel cleanup cron.
CRON_SECRET=
