# Local development template. Keep your real token only in .env or Vercel Environment Variables.
GITHUB_TOKEN=
GITHUB_OWNER=Darshan-U-P
GITHUB_REPO=QuickShare-Storage
GITHUB_BRANCH=main

# Optional canonical public URL; leave blank to use the current request host.
PUBLIC_BASE_URL=

# Keep debug disabled except for local debugging.
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-random-local-secret
# Vercel function request/response bodies are limited to 4.5 MB; app cap is hard-limited to 3 MB.
MAX_CONTENT_LENGTH_MB=3
