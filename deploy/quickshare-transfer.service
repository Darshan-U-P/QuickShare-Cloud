[Unit]
Description=QuickShare Cloud private large-file transfer service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quickshare
Group=quickshare
WorkingDirectory=/opt/quickshare-cloud
EnvironmentFile=/etc/quickshare-transfer.env
ExecStart=/opt/quickshare-cloud/.venv/bin/gunicorn --worker-class gthread --workers 2 --threads 16 --timeout 0 --bind 127.0.0.1:8081 transfer_service:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/quickshare-transfer

[Install]
WantedBy=multi-user.target
