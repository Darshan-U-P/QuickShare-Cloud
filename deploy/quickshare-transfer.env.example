# Copy to /etc/quickshare-transfer.env on the VPS and chmod 600 it.
# Set the same TRANSFER_TOKEN_SECRET value in Vercel.
TRANSFER_TOKEN_SECRET=replace-with-a-long-random-secret
TRANSFER_TICKET_MAX_AGE_SECONDS=172800
TRANSFER_DB_PATH=/var/lib/quickshare-transfer/sessions.sqlite3

# Same administrator Drive OAuth credentials used by the Vercel web app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional, if already configured for the web app.
GOOGLE_DRIVE_FOLDER_ID=
